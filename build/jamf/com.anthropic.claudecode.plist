<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>allowManagedHooksOnly</key>
	<true/>
	<key>allowManagedMcpServersOnly</key>
	<true/>
	<key>allowedMcpServers</key>
	<array/>
	<key>permissions</key>
	<dict>
		<key>disableBypassPermissionsMode</key>
		<string>disable</string>
		<key>deny</key>
		<array>
			<string>Read(~/.ssh/**)</string>
			<string>Read(~/.aws/**)</string>
			<string>Read(~/.config/gcloud/**)</string>
			<string>Read(~/.kube/**)</string>
			<string>Read(~/.docker/config.json)</string>
			<string>Read(~/.netrc)</string>
			<string>Read(~/.npmrc)</string>
			<string>Read(~/.config/gh/**)</string>
			<string>WebSearch</string>
		</array>
	</dict>
	<key>sandbox</key>
	<dict>
		<key>enabled</key>
		<true/>
		<key>failIfUnavailable</key>
		<true/>
		<key>allowUnsandboxedCommands</key>
		<false/>
		<key>enableWeakerNetworkIsolation</key>
		<false/>
		<key>allowAppleEvents</key>
		<false/>
		<key>filesystem</key>
		<dict>
			<key>allowManagedReadPathsOnly</key>
			<true/>
		</dict>
		<key>credentials</key>
		<dict>
			<key>files</key>
			<array>
				<dict>
					<key>path</key>
					<string>~/.ssh</string>
					<key>mode</key>
					<string>deny</string>
				</dict>
				<dict>
					<key>path</key>
					<string>~/.aws</string>
					<key>mode</key>
					<string>deny</string>
				</dict>
				<dict>
					<key>path</key>
					<string>~/.config/gcloud</string>
					<key>mode</key>
					<string>deny</string>
				</dict>
				<dict>
					<key>path</key>
					<string>~/.kube</string>
					<key>mode</key>
					<string>deny</string>
				</dict>
				<dict>
					<key>path</key>
					<string>~/.docker/config.json</string>
					<key>mode</key>
					<string>deny</string>
				</dict>
				<dict>
					<key>path</key>
					<string>~/.netrc</string>
					<key>mode</key>
					<string>deny</string>
				</dict>
				<dict>
					<key>path</key>
					<string>~/.npmrc</string>
					<key>mode</key>
					<string>deny</string>
				</dict>
				<dict>
					<key>path</key>
					<string>~/.config/gh</string>
					<key>mode</key>
					<string>deny</string>
				</dict>
			</array>
			<key>envVars</key>
			<array>
				<dict>
					<key>name</key>
					<string>GITHUB_TOKEN</string>
					<key>mode</key>
					<string>deny</string>
				</dict>
				<dict>
					<key>name</key>
					<string>GH_TOKEN</string>
					<key>mode</key>
					<string>deny</string>
				</dict>
				<dict>
					<key>name</key>
					<string>NPM_TOKEN</string>
					<key>mode</key>
					<string>deny</string>
				</dict>
				<dict>
					<key>name</key>
					<string>AWS_ACCESS_KEY_ID</string>
					<key>mode</key>
					<string>deny</string>
				</dict>
				<dict>
					<key>name</key>
					<string>AWS_SECRET_ACCESS_KEY</string>
					<key>mode</key>
					<string>deny</string>
				</dict>
				<dict>
					<key>name</key>
					<string>AWS_SESSION_TOKEN</string>
					<key>mode</key>
					<string>deny</string>
				</dict>
			</array>
		</dict>
		<key>network</key>
		<dict>
			<key>allowedDomains</key>
			<array>
				<string>github.com</string>
				<string>api.github.com</string>
				<string>codeload.github.com</string>
				<string>registry.npmjs.org</string>
				<string>pypi.org</string>
				<string>files.pythonhosted.org</string>
				<string>api.anthropic.com</string>
				<string>api.openai.com</string>
			</array>
			<key>allowManagedDomainsOnly</key>
			<true/>
		</dict>
	</dict>
	<key>allowManagedPermissionRulesOnly</key>
	<true/>
	<key>strictKnownMarketplaces</key>
	<array/>
	<key>disableSideloadFlags</key>
	<true/>
	<key>disableSkillShellExecution</key>
	<true/>
	<key>autoUpdatesChannel</key>
	<string>stable</string>
	<key>env</key>
	<dict>
		<key>ANTHROPIC_BASE_URL</key>
		<string>https://api.anthropic.com</string>
	</dict>
</dict>
</plist>
